# Gemini is the default real-analysis provider.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# Required together with --execute by the catalog:image script. Keep false for dry-runs.
ALLOW_CATALOG_IMAGE_GENERATION=false

# Optional future provider. Leave empty unless AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini

# When true, no provider is contacted.
ANALYSIS_DEMO_MODE=false
PORT=3001
